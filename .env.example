# V-SHIELD — Environment Configuration Template (SIH 2026)
# Copy to .env and configure local/production values.
# NEVER commit .env to version control.

# Application Runtime
PROJECT_NAME="V-SHIELD"
VERSION="1.0.0"
DEBUG=False
CORS_ORIGINS=["*"]

# Authentication & Session Security (HS256 JWT)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_MAX_DURATION_SECONDS=3600
DEMO_OPERATOR_USERNAME="analyst@vshield.internal"
DEMO_OPERATOR_PASSWORD="VShieldSecure2026!"

# Twilio Telephony & Live Voice Webhook Gateway
# Public Base URL (e.g. ngrok HTTPS forwarding address) used to construct wss:// Media Stream URL
TWILIO_PUBLIC_BASE_URL="https://example.ngrok-free.app"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"

# Twilio Verify / Out-of-Band MFA Service
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MFA_ENABLED=True
MFA_COOLDOWN_SECONDS=120
DEFAULT_MFA_TARGET_PHONE="+919876543210"

# Hyperparameters & Model Paths (Optional Overrides)
# RISK_ALPHA=0.70
# VAD_MARGIN_SEC=0.30
# VSHIELD_ANTISPOOF_MODEL_PATH=""
