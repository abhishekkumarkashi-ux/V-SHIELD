# V-SHIELD — Environment Configuration Template (SIH 2026)
# Copy to .env for local development or configure in Render / Vercel dashboard.
# NEVER commit .env to version control.

# =====================================================================
# Application Runtime & Network Topology
# =====================================================================
PROJECT_NAME="V-SHIELD"
VERSION="1.0.0"
ENVIRONMENT="development"  # "development", "staging", "production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:5173"  # Production: https://<your-vercel-domain>.vercel.app
BACKEND_URL="http://localhost:8000"   # Production: https://<your-render-domain>.onrender.com
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]  # Comma-separated or JSON list of authorized frontend origins

# =====================================================================
# Database Configuration (PostgreSQL in Production, SQLite in Dev)
# =====================================================================
# In production on Render, set DATABASE_URL from your Render PostgreSQL database instance:
# DATABASE_URL="postgresql://user:password@host:5432/vshield"
# If unset or empty, V-SHIELD automatically defaults to local SQLite (backend/app/vshield.db):
DATABASE_URL=""

# =====================================================================
# Authentication & Session Security (HMAC-SHA256 JWT)
# =====================================================================
# In production, mandatory to set a strong cryptographically random string (e.g. 64+ hex characters):
JWT_SECRET_KEY="vshield-dev-insecure-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_MAX_DURATION_SECONDS=3600
DEMO_OPERATOR_USERNAME="analyst@vshield.internal"
DEMO_OPERATOR_PASSWORD="VShieldDev2026!"  # Mandatory to override in production

# =====================================================================
# Google OAuth 2.0 / OpenID Connect
# =====================================================================
# Obtain Client ID & Secret from Google Cloud Console (APIs & Services > Credentials)
# Authorized JavaScript origin: https://<your-vercel-domain>.vercel.app (or http://localhost:5173 in dev)
# Authorized redirect URI: https://<your-render-domain>.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# =====================================================================
# Twilio Telephony & Live Voice Webhook Gateway
# =====================================================================
# Public Base URL (e.g. https://<your-render-domain>.onrender.com or ngrok HTTPS address)
TWILIO_PUBLIC_BASE_URL="http://localhost:8000"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MFA_ENABLED=True
MFA_COOLDOWN_SECONDS=120
DEFAULT_MFA_TARGET_PHONE="+919876543210"

# =====================================================================
# Frontend Vercel Environment Variables (Configure in Vercel Dashboard)
# =====================================================================
# VITE_API_URL="https://<your-render-domain>.onrender.com"
# VITE_WS_URL="wss://<your-render-domain>.onrender.com/ws/live-call"

# =====================================================================
# Hyperparameters & Model Configuration (Optional Overrides)
# =====================================================================
# RISK_ALPHA=0.70
# VAD_MARGIN_SEC=0.30
# VSHIELD_ANTISPOOF_MODEL_PATH=""
